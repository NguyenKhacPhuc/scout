# Copy to .env and fill locally. Never send these values in chat or commit .env.
SCOUT_TEST_EMAIL=
SCOUT_TEST_PASSWORD=
# TypeSafe's Jev model selects operations/elements and judges classification checkpoints.
TYPESAFE_API_KEY=
# Optional: set to "llm" to choose actions with the OpenAI-compatible TEXT_MODEL below
# (or SCOUT_DECISION_MODEL / SCOUT_DECISION_MODEL_BASE_URL) instead of Jev.
SCOUT_DECISION_AGENT=jev
# OpenAI-compatible chat model: the llm decision agent, and standalone-runner text for
# non-credential fields (MCP runs ask the host via enter_text instead).
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat

# Optional Android package used when a case or prompt run names none. It applies
# only to the General project or the project named by SCOUT_DEFAULT_PROJECT.
SCOUT_DEFAULT_PACKAGE=
SCOUT_DEFAULT_PROJECT=

# Optional path to the Android Debug Bridge executable.
ADB_PATH=

# Android backend: appium (default) or adb (explicit fallback).
SCOUT_ANDROID_DRIVER=appium
SCOUT_APPIUM_URL=http://127.0.0.1:4723
# One-second idle wait; raise to 10000 if a screen needs more settling time.
SCOUT_APPIUM_IDLE_TIMEOUT_MS=1000

# Dashboard origin used in links returned by prompt-driven MCP runs.
SCOUT_DASHBOARD_URL=http://localhost:5173

# iOS always uses Appium/XCUITest. Configure your own Apple development team.
SCOUT_IOS_TEAM_ID=
SCOUT_IOS_SIGNING_ID=Apple Development
SCOUT_IOS_WDA_BUNDLE_ID=
# Set true only when a correctly signed WebDriverAgent is already installed.
SCOUT_IOS_USE_PREINSTALLED_WDA=false

# Optional HTTP/WebSocket sandbox. Keep loopback by default; physical devices
# need an explicitly configured reachable IP on your dedicated test network.
SCOUT_SANDBOX_HOST=127.0.0.1
SCOUT_SANDBOX_PORT=8899
